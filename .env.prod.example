# === ResPawn Production Environment Variables ===
# Copy this to .env.prod and fill in real values. NEVER commit .env.prod.

# --- PostgreSQL ---
POSTGRES_DB=respawn
DB_USERNAME=respawn_user
DB_PASSWORD=<STRONG_PASSWORD_HERE>
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://postgres:5432/respawn
DOCKER_DB_URL=jdbc:postgresql://postgres:5432/respawn

# --- RabbitMQ ---
RABBITMQ_USERNAME=<RABBITMQ_USER>
RABBITMQ_PASSWORD=<STRONG_PASSWORD_HERE>
RABBITMQ_HOST=respawn_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ__HOST=respawn_rabbitmq
RABBITMQ__USERNAME=<RABBITMQ_USER>
RABBITMQ__PASSWORD=<STRONG_PASSWORD_HERE>

# --- gRPC ---
GrpcServer__Address=<YOUR_GRPC_SERVER_ADDRESS> # e.g. http://grpc-server-service:8060

# --- JWT ---
JWT__KEY=<LONG_RANDOM_STRING_MIN_32_CHARS>
JWT__ISSUER=JWTAuthenticationServer
JWT__AUDIENCE=JWTServiceBlazorClient
JWT__SUBJECT=JWTServiceAccessToken

# --- CORS (React frontend origin) ---
CORS_ORIGIN=<YOUR_FRONTEND_ORIGIN> # e.g. https://yoururl.dk

# --- Confluent Cloud Kafka ---
CONFLUENT_API_KEY=<YOUR_CONFLUENT_API_KEY>
CONFLUENT_API_SECRET=<YOUR_CONFLUENT_API_SECRET>

# --- SMTP (Mailgun) ---
SMTP__USERNAME=<MAILGUN_SMTP_USERNAME>
SMTP__PASSWORD=<MAILGUN_SMTP_PASSWORD>

# --- Reseller Seed (first boot only, skipped if resellers already exist) ---
SEED_RESELLER_NAME=Store Admin
SEED_RESELLER_USERNAME=admin
SEED_RESELLER_PASSWORD=<STRONG_PASSWORD_HERE>
